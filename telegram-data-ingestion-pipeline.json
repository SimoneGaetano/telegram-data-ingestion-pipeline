        "query": "SELECT \n    categoria, \n    SUM(cifra) as totale_categoria,\n    (SELECT SUM(cifra) FROM spese WHERE data_spesa >= NOW() - INTERVAL '7 days') as totale_complessivo\nFROM spese \nWHERE data_spesa >= NOW() - INTERVAL '7 days'\nGROUP BY categoria;\n",
