    {
      "parameters": {
        "jsCode": "// Recupera l'input dal nodo HTTP Request\nconst items = $input.all();\nif (!items || items.length === 0) return [];\n\nconst inputData = items[0].json;\n\n// Prende la lista dei messaggi (result)\nconst resultList = inputData.result;\nif (!resultList || !Array.isArray(resultList) || resultList.length === 0) {\n  return [{ json: { info: \"Nessun messaggio trovato\" } }];\n}\n\n// Prende l'ultimo messaggio ricevuto in ordine cronologico\nconst ultimoElemento = resultList[resultList.length - 1];\nconst telegramData = ultimoElemento.message;\n\nif (!telegramData) return [];\n\nconst testoCompleto = telegramData.text || \"\";\nconst chatId = telegramData.chat?.id;\nconst username = telegramData.from?.username || \"Utente Anonimo\";\n\n// Estrae i numeri dal testo del messaggio (es: \"10\")\nconst numeriTrovati = testoCompleto.match(/\\d+(\\.\\d+)?/);\nconst cifra = numeriTrovati ? parseFloat(numeriTrovati[0]) : 0;\n\n// Isola la categoria cercando la parola \"per\"\nlet categoria = \"Generica\";\nif (testoCompleto.toLowerCase().includes(\" per \")) {\n  const parti = testoCompleto.split(/ per /i);\n  if (parti.length > 1) {\n    categoria = parti[1].trim();\n  }\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    username: username,\n    testo_originale: testoCompleto,\n    cifra: cifra,\n    categoria: categoria,\n    data_spesa: new Date().toISOString()\n  }\n}];\n"
      },
